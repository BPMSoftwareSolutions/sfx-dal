<Project>
  <!-- Keep the separately generated identity assembly and the semantic projection projects out of the estate project. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SFX.DAL'">
    <DefaultItemExcludes>$(DefaultItemExcludes);identity/**;tools/**;semantic/**;.tmp/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SFX.Identity.DAL'">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>

