  "description": "Projects analysis.read_capability_details document mode (emit=0) into an immutable capability snapshot. Seven sections are typed; the other 38 expected sections are retained verbatim. Sections the reader emits without an outer ORDER BY are declared order-free. Referenced declarations, contracts, ports and bindings form the revision vector; the estate pin is a mutable pointer and must equal the basis the reader reports.",
  "source": {
    "kind": "sql-procedure-document",
    "schema": "analysis",
    "name": "read_capability_details",
    "shapeBasis": "Field types and nullability come from the row-mode column metadata in verification/2026-10-09-semantic-readers.json. A field is required only when that metadata is NOT NULL or the installed reader's ROW discriminator depends on it (reader body UTF-8 SHA-256 d1b0018a89c237eb8a3f1b5ca1249ae289463f4c167100797b9b639c48a3929f).",
    "arguments": [
      { "parameter": "capability_id", "sqlType": "nvarchar", "size": 400, "bind": "argument", "role": "identity" },
      { "parameter": "estate_model_pk", "sqlType": "bigint", "bind": "argument", "role": "basis" },
      { "parameter": "capability_version_pk", "sqlType": "bigint", "bind": "omit" },
      { "parameter": "emit", "sqlType": "bit", "bind": "constant", "value": false }
    ],
    "document": {
      "parameter": "result",
      "shape": "named-sections",
      "nulls": "explicit",
      "rowResultSets": "forbid"
    },
    "refusals": [
      { "errorNumber": 51000, "code": "CAPABILITY_NOT_FOUND", "availability": "Absent" },
      { "errorNumber": 51000, "code": "CAPABILITY_NOT_SELECTED", "availability": "Absent" }
    ]
  },
  "rows": {
